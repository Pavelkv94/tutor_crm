// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id          Int      @id @default(autoincrement())
  name        String
	login       String @unique
	password    String
	role        TeacherRole @default(TEACHER)
	timezone    Timezone?
	birth_date  DateTime?

	lessons Lesson[]
	students Student[]
	regular_lessons RegularLesson[]
	tasks Task[]

  created_at  DateTime @default(now())
	deleted_at DateTime?
  telegrams  Telegram[]
	telegram_tokens TelegramToken[]
	task_comments TaskComment[]
	file_accesses FileAccess[]
	course_accesses CourseAccess[]
	payments_created Payment[]
	billing_details TeacherBillingDetails?

	@@map("teacher")
}

/// Платёжные реквизиты преподавателя для счёта (rachunek), который он выставляет школе.
/// Вынесены в отдельную таблицу, а не в teacher: полей много, все опциональные и нужны
/// только при формировании счёта.
model TeacherBillingDetails {
	id              Int      @id @default(autoincrement())
	teacher_id      Int      @unique

	/// ФИО латиницей — в счёте шапка на польском и русском, а имя пишется транслитерацией.
	full_name_latin String?
	address         String?
	passport        String?
	email           String?
	bank_name       String?
	bank_account    String?

	created_at      DateTime @default(now())
	updated_at      DateTime @updatedAt

	teacher         Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

	@@map("teacher_billing_details")
}

model Student {
  id         Int        @id @default(autoincrement())
  name       String
  class      Int
  birth_date DateTime?
	/// Остаток на балансе в минорных единицах валюты: 3400 — это 34,00. В минорных единицах
	/// хранятся все деньги проекта — скидка и пересчёт по курсу дают копейки, а плавающая
	/// точка в денежных расчётах не используется нигде.
	balance    Int @default(0)
	/// Персональная скидка ученика в процентах, 0 — скидки нет. Применяется к цене каждого
	/// занятия, а не к итогу счёта: баланс закрывает занятия поштучно, и скидка на итог
	/// оставила бы последнее занятие неоплаченным. Диапазон закреплён CHECK-констрейнтом
	/// student_discount_check, потолок в 10% — валидацией DTO (MAX_STUDENT_DISCOUNT_PERCENT).
	discount   Int @default(0)
	marketing_consent Boolean @default(false)
	/// Когда получен ответ про маркетинговое согласие. NULL — вопрос ещё не задавали,
	/// и его нужно показать на странице оплаты. Отказ — такой же зафиксированный ответ,
	/// как согласие, поэтому сам ответ живёт в marketing_consent, а факт ответа — здесь.
	marketing_consent_at DateTime?
	/// Валюта текущего остатка на балансе. NULL при balance = 0 — валюта «отпущена»,
	/// ученик может перейти на другую. Инвариант закреплён CHECK-констрейнтом
	/// student_balance_currency_check (см. миграцию rename_payment_currency_to_balance_currency).
	balance_currency Currency?
	/// Как ученик платит. Только это поле решает, выставлять ли ссылку Stripe.
	/// NULL — способ не выбран: ссылки нет, счёт уходит текстом с просьбой прислать чек.
	/// Валюту счёта поле не задаёт — она по-прежнему выводится из планов занятий.
	payment_method PaymentMethod?

	notifyAboutBirthday Boolean @default(true)
	notifyAboutLessons Boolean @default(true)
	bookUntilCancellation Boolean @default(false)
  created_at DateTime   @default(now())
	teacher_id Int?
	timezone Timezone?

	teacher     Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

	regular_lessons RegularLesson[]
  telegrams  Telegram[]
  lessons    Lesson[]
	telegram_tokens TelegramToken[]
	payments Payment[]
	lesson_payments LessonPayment[]

	deleted_at DateTime?

	@@index([teacher_id, deleted_at])
	@@map("student")
}

model RegularLesson {
	id Int @id @default(autoincrement())
	plan_id Int
	student_id Int
	teacher_id Int
	start_time String
	week_day WeekDay
	start_period_date DateTime
	end_period_date DateTime

	created_at DateTime @default(now())
	deleted_at DateTime?

	teacher     Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
	student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
	plan        Plan     @relation(fields: [plan_id], references: [id])

	lessons Lesson[]

	@@map("regular_lesson")
}

model Lesson {
  id          Int      @id @default(autoincrement())
  student_id  Int
	teacher_id Int
  plan_id     Int
	status      LessonStatus @default(PENDING_UNPAID)
	comment     String?
	date  DateTime @db.Timestamptz
	is_regular Boolean @default(false)

	is_free Boolean @default(false)
	is_trial Boolean @default(false)

	rescheduled_lesson_id Int?
	rescheduled_lesson_date DateTime?
	rescheduled_to_lesson_id Int?
	rescheduled_to_lesson_date DateTime?

  created_at  DateTime @default(now())

	regular_lesson_id Int?

	teacher     Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  plan        Plan     @relation(fields: [plan_id], references: [id])

	regular_lesson RegularLesson? @relation(fields: [regular_lesson_id], references: [id])

	lesson_payments LessonPayment[]

	@@index([teacher_id, date])
	@@index([student_id, date])
	@@index([status, date])
	@@map("lesson")
}

model Plan {
  id            Int         @id @default(autoincrement())
  plan_type     PlanType
  plan_currency Currency
	plan_name     String
  duration      Int
	/// Цена одного занятия в минорных единицах plan_currency: 3400 — это 34,00.
	plan_price    Int
  created_at    DateTime    @default(now())
	deleted_at    DateTime?

	stripe_product_id String? @unique
	stripe_price_id   String? @unique

  lessons       Lesson[]
	regular_lessons RegularLesson[]

	@@map("plan")
}

model Payment {
	id            Int           @id @default(autoincrement())
	student_id    Int
	type          PaymentType
	status        PaymentStatus @default(PENDING)
	/// Знаковая сумма операции в минорных единицах `currency`.
	amount        Int
	currency      Currency
	/// Скидка ученика на момент выставления счёта. Снимок нужен, чтобы пришедшая оплата
	/// разложилась по тем же ценам, по которым счёт был посчитан, даже если скидку ученика
	/// успели изменить между выставлением и оплатой.
	discount_percent Int @default(0)

	period_start  DateTime?
	period_end    DateTime?
	lessons_count Int?
	comment       String?

	created_by_id Int?

	stripe_payment_link_id      String? @unique
	stripe_checkout_session_id  String? @unique
	stripe_payment_intent_id    String? @unique
	/// Заполняется только у строк типа STRIPE_REFUND. У возврата тот же payment_intent,
	/// что у исходного платежа, поэтому переиспользовать stripe_payment_intent_id нельзя — @unique.
	stripe_refund_id            String? @unique

	/// Валюта, в которой предъявлена ссылка Stripe, когда она отличается от валюты счёта.
	/// NULL — конвертации не было. Учёт при этом всегда идёт в `currency`: amount и валюта
	/// счёта не меняются, а тройка charge_* — только способ предъявления, нужный вебхуку
	/// для сверки и для пропорции возврата. Тройка живёт целиком или не живёт вовсе —
	/// закреплено CHECK-констрейнтом payment_charge_conversion_check.
	charge_currency     Currency?
	/// Сумма ссылки в минорных единицах charge_currency (евроцентах).
	charge_amount_minor Int?
	/// Курс, по которому посчитана сумма ссылки: сотые доли `currency` за единицу
	/// charge_currency (500 = 1 € = 5.00 BYN). Снимок на момент выставления — правка курса
	/// после этого не должна менять уже выставленный счёт.
	charge_rate         Int?

	paid_at    DateTime?
	created_at DateTime @default(now())
	updated_at DateTime @updatedAt

	student    Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
	created_by Teacher? @relation(fields: [created_by_id], references: [id])

	lesson_payments LessonPayment[]

	@@index([student_id, created_at])
	@@map("payment")
}

model LessonPayment {
	id         Int       @id @default(autoincrement())
	student_id Int
	lesson_id  Int
	payment_id Int?
	/// Сумма списания за занятие в минорных единицах `currency`.
	amount     Int
	currency   Currency
	created_at DateTime  @default(now())
	reverted_at DateTime?

	student Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
	lesson  Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
	payment Payment? @relation(fields: [payment_id], references: [id])

	@@index([student_id, reverted_at])
	@@index([lesson_id])
	@@map("lesson_payment")
}

model StripeWebhookEvent {
	id           String    @id
	type         String
	received_at  DateTime  @default(now())
	processed_at DateTime?
	error        String?

	@@map("stripe_webhook_event")
}

model Telegram {
  id          Int      @id @default(autoincrement())
  student_id Int?
  teacher_id Int?
  telegram_id String @unique
	username String?
	first_name String?
  type        TelegramType @default(STUDENT)
  created_at  DateTime @default(now())

	student     Student?  @relation(fields: [student_id], references: [id], onDelete: Cascade)
	teacher     Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

	@@map("telegram")
}

model TelegramToken {
	id Int @id @default(autoincrement())
	type TelegramType

  student_id Int?
  teacher_id Int?
	token String @unique
	expired_at DateTime
	created_at DateTime @default(now())

	teacher     Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [student_id], references: [id], onDelete: Cascade)


	@@map("telegram_token")
}

model Task {
	id String @id @default(uuid())
	description String

	status TaskStatus @default(IN_PROGRESS)

	color String

	teacher_id Int
	created_at DateTime @default(now())
	updated_at DateTime @updatedAt

	teacher     Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
	task_comments TaskComment[]

	@@index([teacher_id, status])
	@@map("task")
}

model TaskComment {
	id String @id @default(uuid())

	task_id String
	comment String

	commenter_id Int

	commenter Teacher @relation(fields: [commenter_id], references: [id])

	created_at DateTime @default(now())

	task     Task  @relation(fields: [task_id], references: [id])

	@@map("task_comment")
}

model Course {
	id Int @id @default(autoincrement())
	name String

	created_at DateTime @default(now())

	files File[]
	accesses CourseAccess[]

	@@map("file_category")
}
model File {
	id Int @id @default(autoincrement())

	storage_key String
	original_name String
	mime_type String
	size_bytes Int

	type FileType
	course_id Int

	upload_status UploadStatus @default(UPLOADING)
	
	course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
	file_accesses FileAccess[]

	created_at DateTime @default(now())

	@@index([course_id, upload_status])
	@@map("file")
}

model FileAccess {
	id Int @id @default(autoincrement())

	teacher_id Int
	file_id Int

	type FileAccessType @default(ALLOW)

	created_at DateTime @default(now())

	teacher Teacher @relation(fields: [teacher_id], references: [id])
	file File @relation(fields: [file_id], references: [id], onDelete: Cascade)

	@@unique([teacher_id, file_id])
	@@map("file_access")
}

model CourseAccess {
	id Int @id @default(autoincrement())

	teacher_id Int
	course_id Int

	created_at DateTime @default(now())

	teacher Teacher @relation(fields: [teacher_id], references: [id])
	course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

	@@unique([teacher_id, course_id])
	@@map("course_access")
}


/// Глобальные настройки школы. Строка ровно одна: id закреплён CHECK-констрейнтом
/// school_settings_singleton_check, репозиторий работает через upsert по id = 1.
model SchoolSettings {
	id Int @id @default(1)

	/// Внутренний курс евро в сотых долях BYN: 500 = 1 € = 5.00 BYN. 0 — курс не задан,
	/// и ссылки на оплату для BYN-занятий не выставляются. Целое, а не Decimal: плавающая
	/// точка в денежных расчётах в проекте не используется нигде.
	eur_rate Int @default(0)

	updated_at DateTime @updatedAt

	@@map("school_settings")
}

enum UploadStatus {
	UPLOADING
	UPLOADED
	FAILED
}

enum FileType {
	PDF
	HTML
}

enum FileAccessType {
	ALLOW
	DENY
}

enum Currency {
  EUR
  PLN
	BYN
}

/// Как ученик оплачивает занятия. STRIPE — счёт предъявляется ссылкой на оплату картой;
/// BYN_ACCOUNT — оплата принимается вне системы, в счёте просим прислать чек.
enum PaymentMethod {
	STRIPE
	BYN_ACCOUNT
}

enum PaymentType {
	STRIPE_PAYMENT
	STRIPE_REFUND
	MANUAL_ADJUSTMENT
	LEGACY_OPENING_BALANCE
}

enum PaymentStatus {
	PENDING
	SUCCEEDED
	CANCELED
	FAILED
	/// Платёж получен, но не применён к балансу из-за конфликта валют.
	/// В инвариант баланса не входит, применяется вручную через POST /api/payments/:id/apply.
	REQUIRES_ATTENTION
}

enum TelegramType {
	TEACHER
	STUDENT
	PARENT
}

enum TaskStatus {
	IN_PROGRESS
	ON_APPROVAL
	COMPLETED
}


enum PlanType {
  INDIVIDUAL
  PAIR
}

enum LessonStatus {
  PENDING_PAID
	PENDING_UNPAID
  COMPLETED_PAID
	COMPLETED_UNPAID
	MISSED
	RESCHEDULED
  CANCELLED
}

enum TeacherRole {
  TEACHER
  ADMIN
}

enum Timezone {
	BY
	PL
	KZ
	GE
	RU
	EU
}

enum WeekDay {
	MONDAY
	TUESDAY
	WEDNESDAY
	THURSDAY
	FRIDAY
	SATURDAY
	SUNDAY
}