// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id          Int      @id @default(autoincrement())
  name        String
	login       String @unique
	password    String
	role        TeacherRole @default(TEACHER)
	timezone    Timezone?

	lessons Lesson[]
	students Student[]
	regular_lessons RegularLesson[]
	tasks Task[]

  created_at  DateTime @default(now())
	deleted_at DateTime?
  telegrams  Telegram[]
	telegram_tokens TelegramToken[]
	task_comments TaskComment[]
	file_accesses FileAccess[]
	course_accesses CourseAccess[]
	payments_created Payment[]

	@@map("teacher")
}

model Student {
  id         Int        @id @default(autoincrement())
  name       String
  class      Int
  birth_date DateTime?
	balance    Int @default(0)
	marketing_consent Boolean @default(false)
	/// Когда получен ответ про маркетинговое согласие. NULL — вопрос ещё не задавали,
	/// и его нужно показать на странице оплаты. Отказ — такой же зафиксированный ответ,
	/// как согласие, поэтому сам ответ живёт в marketing_consent, а факт ответа — здесь.
	marketing_consent_at DateTime?
	/// Когда приняты условия обслуживания. NULL — не приняты (Stripe отдаёт только
	/// «accepted», отказа не бывает, поэтому отдельный boolean не нужен).
	terms_accepted_at DateTime?
	/// Валюта текущего остатка на балансе. NULL при balance = 0 — валюта «отпущена»,
	/// ученик может перейти на другую. Инвариант закреплён CHECK-констрейнтом
	/// student_balance_currency_check (см. миграцию rename_payment_currency_to_balance_currency).
	balance_currency Currency?

	notifyAboutBirthday Boolean @default(true)
	notifyAboutLessons Boolean @default(true)
	bookUntilCancellation Boolean @default(false)
  created_at DateTime   @default(now())
	teacher_id Int?
	timezone Timezone?

	teacher     Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

	regular_lessons RegularLesson[]
  telegrams  Telegram[]
  lessons    Lesson[]
	telegram_tokens TelegramToken[]
	payments Payment[]
	lesson_payments LessonPayment[]

	deleted_at DateTime?

	@@index([teacher_id, deleted_at])
	@@map("student")
}

model RegularLesson {
	id Int @id @default(autoincrement())
	plan_id Int
	student_id Int
	teacher_id Int
	start_time String
	week_day WeekDay
	start_period_date DateTime
	end_period_date DateTime

	created_at DateTime @default(now())
	deleted_at DateTime?

	teacher     Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
	student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
	plan        Plan     @relation(fields: [plan_id], references: [id])

	lessons Lesson[]

	@@map("regular_lesson")
}

model Lesson {
  id          Int      @id @default(autoincrement())
  student_id  Int
	teacher_id Int
  plan_id     Int
	status      LessonStatus @default(PENDING_UNPAID)
	comment     String?
	date  DateTime @db.Timestamptz
	is_regular Boolean @default(false)

	is_free Boolean @default(false)
	is_trial Boolean @default(false)

	rescheduled_lesson_id Int?
	rescheduled_lesson_date DateTime?
	rescheduled_to_lesson_id Int?
	rescheduled_to_lesson_date DateTime?

  created_at  DateTime @default(now())

	regular_lesson_id Int?

	teacher     Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  plan        Plan     @relation(fields: [plan_id], references: [id])

	regular_lesson RegularLesson? @relation(fields: [regular_lesson_id], references: [id])

	lesson_payments LessonPayment[]

	@@index([teacher_id, date])
	@@index([student_id, date])
	@@index([status, date])
	@@map("lesson")
}

model Plan {
  id            Int         @id @default(autoincrement())
  plan_type     PlanType
  plan_currency Currency
	plan_name     String
  duration      Int
	plan_price    Int
  created_at    DateTime    @default(now())
	deleted_at    DateTime?

	stripe_product_id String? @unique
	stripe_price_id   String? @unique

  lessons       Lesson[]
	regular_lessons RegularLesson[]

	@@map("plan")
}

model Payment {
	id            Int           @id @default(autoincrement())
	student_id    Int
	type          PaymentType
	status        PaymentStatus @default(PENDING)
	amount        Int
	currency      Currency

	period_start  DateTime?
	period_end    DateTime?
	lessons_count Int?
	comment       String?

	created_by_id Int?

	stripe_payment_link_id      String? @unique
	stripe_checkout_session_id  String? @unique
	stripe_payment_intent_id    String? @unique
	/// Заполняется только у строк типа STRIPE_REFUND. У возврата тот же payment_intent,
	/// что у исходного платежа, поэтому переиспользовать stripe_payment_intent_id нельзя — @unique.
	stripe_refund_id            String? @unique

	paid_at    DateTime?
	created_at DateTime @default(now())
	updated_at DateTime @updatedAt

	student    Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
	created_by Teacher? @relation(fields: [created_by_id], references: [id])

	lesson_payments LessonPayment[]

	@@index([student_id, created_at])
	@@map("payment")
}

model LessonPayment {
	id         Int       @id @default(autoincrement())
	student_id Int
	lesson_id  Int
	payment_id Int?
	amount     Int
	currency   Currency
	created_at DateTime  @default(now())
	reverted_at DateTime?

	student Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
	lesson  Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
	payment Payment? @relation(fields: [payment_id], references: [id])

	@@index([student_id, reverted_at])
	@@index([lesson_id])
	@@map("lesson_payment")
}

model StripeWebhookEvent {
	id           String    @id
	type         String
	received_at  DateTime  @default(now())
	processed_at DateTime?
	error        String?

	@@map("stripe_webhook_event")
}

model Telegram {
  id          Int      @id @default(autoincrement())
  student_id Int?
  teacher_id Int?
  telegram_id String @unique
	username String?
	first_name String?
  type        TelegramType @default(STUDENT)
  created_at  DateTime @default(now())

	student     Student?  @relation(fields: [student_id], references: [id], onDelete: Cascade)
	teacher     Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

	@@map("telegram")
}

model TelegramToken {
	id Int @id @default(autoincrement())
	type TelegramType

  student_id Int?
  teacher_id Int?
	token String @unique
	expired_at DateTime
	created_at DateTime @default(now())

	teacher     Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [student_id], references: [id], onDelete: Cascade)


	@@map("telegram_token")
}

model Task {
	id String @id @default(uuid())
	description String

	status TaskStatus @default(IN_PROGRESS)

	color String

	teacher_id Int
	created_at DateTime @default(now())
	updated_at DateTime @updatedAt

	teacher     Teacher?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
	task_comments TaskComment[]

	@@index([teacher_id, status])
	@@map("task")
}

model TaskComment {
	id String @id @default(uuid())

	task_id String
	comment String

	commenter_id Int

	commenter Teacher @relation(fields: [commenter_id], references: [id])

	created_at DateTime @default(now())

	task     Task  @relation(fields: [task_id], references: [id])

	@@map("task_comment")
}

model Course {
	id Int @id @default(autoincrement())
	name String

	created_at DateTime @default(now())

	files File[]
	accesses CourseAccess[]

	@@map("file_category")
}
model File {
	id Int @id @default(autoincrement())

	storage_key String
	original_name String
	mime_type String
	size_bytes Int

	type FileType
	course_id Int

	upload_status UploadStatus @default(UPLOADING)
	
	course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
	file_accesses FileAccess[]

	created_at DateTime @default(now())

	@@index([course_id, upload_status])
	@@map("file")
}

model FileAccess {
	id Int @id @default(autoincrement())

	teacher_id Int
	file_id Int

	type FileAccessType @default(ALLOW)

	created_at DateTime @default(now())

	teacher Teacher @relation(fields: [teacher_id], references: [id])
	file File @relation(fields: [file_id], references: [id], onDelete: Cascade)

	@@unique([teacher_id, file_id])
	@@map("file_access")
}

model CourseAccess {
	id Int @id @default(autoincrement())

	teacher_id Int
	course_id Int

	created_at DateTime @default(now())

	teacher Teacher @relation(fields: [teacher_id], references: [id])
	course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

	@@unique([teacher_id, course_id])
	@@map("course_access")
}


enum UploadStatus {
	UPLOADING
	UPLOADED
	FAILED
}

enum FileType {
	PDF
	HTML
}

enum FileAccessType {
	ALLOW
	DENY
}

enum Currency {
  EUR
  PLN
	BYN
}

enum PaymentType {
	STRIPE_PAYMENT
	STRIPE_REFUND
	MANUAL_ADJUSTMENT
	LEGACY_OPENING_BALANCE
}

enum PaymentStatus {
	PENDING
	SUCCEEDED
	CANCELED
	FAILED
	/// Платёж получен, но не применён к балансу из-за конфликта валют.
	/// В инвариант баланса не входит, применяется вручную через POST /api/payments/:id/apply.
	REQUIRES_ATTENTION
}

enum TelegramType {
	TEACHER
	STUDENT
	PARENT
}

enum TaskStatus {
	IN_PROGRESS
	ON_APPROVAL
	COMPLETED
}


enum PlanType {
  INDIVIDUAL
  PAIR
}

enum LessonStatus {
  PENDING_PAID
	PENDING_UNPAID
  COMPLETED_PAID
	COMPLETED_UNPAID
	MISSED
	RESCHEDULED
  CANCELLED
}

enum TeacherRole {
  TEACHER
  ADMIN
}

enum Timezone {
	BY
	PL
	KZ
	GE
	RU
	EU
}

enum WeekDay {
	MONDAY
	TUESDAY
	WEDNESDAY
	THURSDAY
	FRIDAY
	SATURDAY
	SUNDAY
}